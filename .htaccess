<IfModule mod_rewrite.h>
    RewriteEngine On
    
    # فرض استخدام HTTPS وحذف www (أو توحيد النطاق للأمان الأوروبي)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.(.+) [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # توجيه كافة الطلبات الواردة مباشرة إلى مجلد public
    RewriteRule ^$ public/ [L]
    RewriteRule ^((?!public/).*)$ public/$1 [L,NC]
</IfModule>
